.containerOverride {
    padding-top: 0;
}

.checkboxRow {
    display: flex;
    align-items: center;
    margin: 0 -16px;
    border-radius: 8px;
    transition: var(--t2) background-color;

    &:hover,
    &:focus-within {
        background-color: var(--page-background-additional);
    }
}

.checkboxFull {
    width: 100%;
    padding: 8px 16px;
}

.checkboxRowDisabled {
    &:hover,
    &:focus-within {
        background-color: transparent;
    }
}

.actions {
    display: flex;
    gap: 16px;
    padding: 16px;
    flex-direction: column;

    @media (min-width: 768px) {
        flex-direction: row;
    }
}

.actionButton {
    width: auto;
    min-width: 200px;
    max-width: 100%;
}
